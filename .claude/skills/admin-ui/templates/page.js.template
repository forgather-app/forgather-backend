/**
 * {{ENTITY_PLURAL}} Management Page Script
 * {{ENTITY_KOREAN}} 목록 조회 및 페이지네이션 처리
 *
 * 전역 객체 의존성:
 * - API: HTTP 요청 유틸리티 (api.js)
 * - Auth: 인증 유틸리티 (auth.js)
 * - PaginationUtil: 페이지네이션 렌더링 (pagination.js)
 */

// 전역 상태
let currentPage = 1;
let currentPageSize = 15;
let totalPages = 1;
let totalCount = 0;

/**
 * 필터 상태 관리 객체
 */
const filterState = {
    // 필터 예시: hasProduct: null
};

document.addEventListener('DOMContentLoaded', function () {
    // ==========================================================================
    // DOM 요소 참조
    // ==========================================================================

    const tableBody = document.getElementById('{{ENTITY_LOWER}}TableBody');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const errorMessage = document.getElementById('errorMessage');
    const pageSizeSelect = document.getElementById('pageSize');
    const paginationContainer = document.getElementById('pagination');
    const logoutBtn = document.getElementById('logoutBtn');

    // ==========================================================================
    // UI 상태 관리 함수
    // ==========================================================================

    function showLoading() {
        loadingSpinner.style.display = 'flex';
        tableBody.innerHTML = '';
        paginationContainer.style.display = 'none';
    }

    function hideLoading() {
        loadingSpinner.style.display = 'none';
    }

    function showError(message) {
        errorMessage.textContent = message;
        errorMessage.style.display = 'block';
        tableBody.innerHTML = '';
        paginationContainer.style.display = 'none';
    }

    function hideError() {
        errorMessage.textContent = '';
        errorMessage.style.display = 'none';
    }

    function showToast(message, type = 'info') {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.className = `toast ${type}`;
        toast.classList.add('show');

        setTimeout(() => {
            toast.classList.remove('show');
        }, 3000);
    }

    // ==========================================================================
    // 유틸리티 함수
    // ==========================================================================

    function formatDateTime(dateTimeString) {
        if (!dateTimeString) {
            return '-';
        }

        try {
            const date = new Date(dateTimeString);

            if (isNaN(date.getTime())) {
                return '-';
            }

            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            const seconds = String(date.getSeconds()).padStart(2, '0');

            return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
        } catch (error) {
            console.error('Date formatting error:', error);
            return '-';
        }
    }

    function escapeHtml(text) {
        if (text === null || text === undefined) {
            return '';
        }
        const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.toString().replace(/[&<>"']/g, m => map[m]);
    }

    // ==========================================================================
    // 테이블 렌더링
    // ==========================================================================

    function renderTable(items) {
        if (!items || items.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="{{COLUMN_COUNT}}" style="text-align: center; padding: 3rem; color: var(--text-secondary);">
                        <div class="empty-state">
                            <div class="empty-state-icon">📭</div>
                            <h3>No {{ENTITY_PLURAL}} Found</h3>
                            <p>There are no {{ENTITY_LOWER_PLURAL}} to display.</p>
                        </div>
                    </td>
                </tr>
            `;
            return;
        }

        const rows = items.map(item => {
            {{TABLE_ROW_TEMPLATE}}
        }).join('');

        tableBody.innerHTML = rows;
    }

    // ==========================================================================
    // 페이지네이션
    // ==========================================================================

    function updatePagination() {
        PaginationUtil.render(
            paginationContainer,
            currentPage,
            totalPages,
            totalCount,
            goToPage
        );
    }

    function goToPage(page) {
        if (page < 1 || page > totalPages) {
            return;
        }
        currentPage = page;
        loadData();
    }

    // ==========================================================================
    // 데이터 로드
    // ==========================================================================

    function hasActiveFilters() {
        return Object.values(filterState).some(value => value !== null);
    }

    async function loadData() {
        hideError();
        showLoading();

        try {
            let response;

            if (hasActiveFilters()) {
                response = await API.get{{ENTITY_PLURAL}}ByFilters(currentPage, currentPageSize, filterState);
            } else {
                response = await API.get{{ENTITY_PLURAL}}(currentPage, currentPageSize);
            }

            currentPage = response.currentPage;
            currentPageSize = response.pageSize;
            totalPages = response.totalPages;
            totalCount = response.totalCount;

            renderTable(response.{{ENTITY_LOWER_PLURAL}});
            updatePagination();

        } catch (error) {
            console.error('Failed to load {{ENTITY_LOWER_PLURAL}}:', error);
            showError(error.message || 'Failed to load {{ENTITY_LOWER_PLURAL}}. Please try again.');
        } finally {
            hideLoading();
        }
    }

    // ==========================================================================
    // 이벤트 핸들러
    // ==========================================================================

    function handlePageSizeChange() {
        currentPageSize = parseInt(pageSizeSelect.value);
        currentPage = 1;
        loadData();
    }

    function handleLogout() {
        if (confirm('Are you sure you want to logout?')) {
            Auth.logout();
        }
    }

    function applyFilter() {
        // 필터 값 읽기 및 filterState 업데이트
        currentPage = 1;
        loadData();
    }

    // ==========================================================================
    // 이벤트 리스너 등록
    // ==========================================================================

    pageSizeSelect.addEventListener('change', handlePageSizeChange);
    logoutBtn.addEventListener('click', handleLogout);

    // 키보드 네비게이션
    document.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowLeft' && currentPage > 1) {
            event.preventDefault();
            goToPage(currentPage - 1);
        } else if (event.key === 'ArrowRight' && currentPage < totalPages) {
            event.preventDefault();
            goToPage(currentPage + 1);
        }
    });

    // ==========================================================================
    // Modal Logic (상세 모달 사용 시 활성화)
    // ==========================================================================

    {{MODAL_LOGIC}}

    // ==========================================================================
    // 초기화
    // ==========================================================================

    loadData();
});
